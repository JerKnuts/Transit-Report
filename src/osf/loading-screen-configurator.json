{
  "schemaVersion": 1,
  "title": "Transit Report",
  "description": "Grouped controls for full loading screens. Short transitions show the indicator only.",
  "groups": {
    "Appearance": [
      {
        "key": "badge",
        "label": "Character badge",
        "hint": "Choose the original rank badge, the Orbiting Star emblem, or hide it.",
        "type": "enum",
        "default": "custom",
        "options": {
          "original": "Original",
          "custom": "Orbiting Star",
          "hidden": "Hidden"
        }
      },
      {
        "key": "spinner",
        "label": "Loading indicator",
        "hint": "Choose the original spinner, the Orbiting Star emblem, or hide it.",
        "type": "enum",
        "default": "hidden",
        "options": {
          "original": "Original",
          "custom": "Orbiting Star",
          "hidden": "Hidden"
        }
      },
      {
        "key": "background",
        "label": "Loading background",
        "hint": "Animated orbital chart, artifact-inspired cosmic rings, grav-jump star streaks, or original game images. Full loading screens only.",
        "type": "enum",
        "default": "orbital",
        "options": {
          "original": "Game images",
          "orbital": "Orbital chart",
          "artifact": "Artifact starfield",
          "grav": "Grav-jump tunnel"
        }
      }
    ],
    "Full loading screen": [
      {
        "key": "character",
        "label": "Character",
        "hint": "Name and level.",
        "type": "bool",
        "default": true
      },
      {
        "key": "progress",
        "label": "Progress",
        "hint": "XP bar and XP numbers.",
        "type": "bool",
        "default": true
      },
      {
        "key": "tips",
        "label": "Loading tips",
        "hint": "Show loading tips on loading screens.",
        "type": "bool",
        "default": true
      }
    ],
    "Stat pages": [
      {
        "key": "page_count",
        "label": "Number of stat pages",
        "hint": "Maximum 1\u20135 pages per full load, with four larger lifetime readings per page. Default: two pages.",
        "type": "enum",
        "default": "2",
        "options": {
          "1": "1 page",
          "2": "2 pages",
          "3": "3 pages",
          "4": "4 pages",
          "5": "5 pages"
        }
      }
    ],
    "Testing": [
      {
        "key": "diagnostics",
        "label": "On-screen testing diagnostics",
        "hint": "Show on-screen testing diagnostics on loading screens.",
        "type": "bool",
        "default": false
      }
    ],
    "Lifetime stats": [
      {
        "key": "clock",
        "label": "Local PC time",
        "hint": "Your computer clock in its local time zone. Updates during loading.",
        "type": "enum",
        "default": "12h",
        "options": {
          "off": "Hidden",
          "12h": "12-hour",
          "24h": "24-hour"
        }
      },
      {
        "key": "lifetime_mode",
        "label": "Lifetime display",
        "hint": "Chosen categories, or random lifetime counters from enabled categories. Up to the selected page count.",
        "type": "enum",
        "default": "random",
        "options": {
          "categories": "Chosen categories",
          "random": "Random each load"
        }
      },
      {
        "key": "lifetime_general",
        "label": "General",
        "hint": "Hours Slept, Hours Waiting, Days Passed, Credits Found, Most Credits Carried, Chests Looted, Food Eaten, Chems Taken, Data Slates Read, Magazines Found, Speech Successes, Powers Learned",
